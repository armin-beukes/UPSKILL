<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#111111"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/intro"
            android:textColor="#333333"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/bluetooth_printer"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/bluetoothSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnRefreshBluetooth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/refresh_bluetooth" />

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/standalone_tests"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPlainText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/plain_text_test" />

        <Button
            android:id="@+id/btnReceipt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/receipt_test" />

        <Button
            android:id="@+id/btnQr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/qr_test" />

        <Button
            android:id="@+id/btnFeedCut"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/feed_cut_test" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/trafman_bridge"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSampleUri"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sample_uri" />

        <Button
            android:id="@+id/btnLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/view_logs" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:padding="12dp"
            android:textColor="#111111"
            android:textSize="15sp" />

    </LinearLayout>
</ScrollView>
